<Window x:Class="GateFlowPro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GateFlowPro - Professional Desktop" Height="760" Width="1240" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#0E1A2F">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GateFlowPro" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,14,0,0"/>
                    <TextBlock x:Name="RoleText" Text="Desktop System" Foreground="#AFC3DF" Margin="0,4,0,22"/>
                    <Button Content="Dashboard" Style="{StaticResource MenuButton}" Click="Dashboard_Click"/>
                    <Button Content="Delivery Note / Gate Pass" Style="{StaticResource MenuButton}" Click="Delivery_Click"/>
                    <Button Content="Transport Schedule" Style="{StaticResource MenuButton}" Click="Schedule_Click"/>
                    <Button Content="Vehicle Master" Style="{StaticResource MenuButton}" Click="Vehicle_Click"/>
                    <Button Content="Search Records" Style="{StaticResource MenuButton}" Click="Search_Click"/>
                    <Button Content="Reports" Style="{StaticResource MenuButton}" Click="Reports_Click"/>
                    <Button Content="My Profile" Style="{StaticResource MenuButton}" Click="Profile_Click"/>
                    <Button Content="Users" Style="{StaticResource MenuButton}" Click="Users_Click"/>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Content="Logout" Style="{StaticResource MenuButton}" Background="#172A48" Click="Logout_Click"/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="86"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="White" Padding="24,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="UserText" Text="User" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Border Width="42" Height="42" Background="#E7EEF8" CornerRadius="21">
                            <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22"/>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Dashboard" FontSize="25" FontWeight="Bold"/>
                        <TextBlock x:Name="SubtitleText" Text="Professional gate pass and transport schedule management" Foreground="#65758B"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="MainContent" Margin="18"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
