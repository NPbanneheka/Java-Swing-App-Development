<Application x:Class="GateFlowPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#12355B</Color>
            <Color x:Key="AccentColor">#0B72B9</Color>
            <Color x:Key="SuccessColor">#169B62</Color>
            <Color x:Key="DangerColor">#D64545</Color>
            <Color x:Key="BgColor">#F3F6FA</Color>
            <Color x:Key="TextColor">#152033</Color>
            <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />

            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="18"/>
                <Setter Property="Padding" Value="22"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="1" Opacity="0.12"/>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderBrush" Value="#CDD6E2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,12"/>
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="BorderBrush" Value="#CDD6E2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,12"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="38"/>
                <Setter Property="Padding" Value="8,4"/>
                <Setter Property="Margin" Value="0,4,0,12"/>
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="16,6"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,8,0,0"/>
            </Style>
            <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#E8EEF6"/>
                <Setter Property="Foreground" Value="#12355B"/>
            </Style>
            <Style x:Key="MenuButton" TargetType="Button">
                <Setter Property="Height" Value="44"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="18,0"/>
                <Setter Property="Margin" Value="0,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#DCE8F8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="36"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="White"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
